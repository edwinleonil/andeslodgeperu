---
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { currency, included, notes, roomGroups } from '../data/rooms';
---

<Base
  title="Rooms & Prices"
  description="Single, twin, double, super king-size and triple rooms at Andes Lodge Peru in Yanama. Prices are per room and include breakfast."
  shareImage="room-super-king"
>
  <PageHero title="Our Rooms & Prices" image="balcony-valley-view" eyebrow="Rooms" intro="Prices are per room, per night, and include breakfast." />

  <section class="section intro">
    <div class="wrap">
      <div class="info">
        <div>
          <p class="lead">All prices are per room and include:</p>
          <ul>
            {included.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          {notes.map((note) => <p>{note}</p>)}
        </div>
      </div>
    </div>
  </section>

  {
    roomGroups.map((group, i) => (
      <section class:list={['section', { 'section--sand': i % 2 === 0 }]}>
        <div class:list={['wrap', 'split', 'reveal', { 'split--flip': i % 2 === 1 }]}>
          <Photo name={group.image} class="room-photo" />
          <div>
            <span class="eyebrow">{group.beds}</span>
            <h2>{group.title}</h2>
            {group.rooms.map((room) => (
              <article class="room">
                <div class="room-top">
                  <h3>{room.name}</h3>
                  <p class="price">
                    <span class="cur">{currency}</span> {room.price}
                    <span class="per">per night</span>
                  </p>
                </div>
                <p>{room.bathroom}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="wrap cta">
      <h2>Ready to stay?</h2>
      <p>To book a room, message us on WhatsApp. No payment is needed to book; you pay in cash when you arrive.</p>
      <a class="button" href="/#reservation">Make a reservation</a>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .info {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    padding: clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--line);
    border-left: 4px solid var(--red);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .info p:last-child,
  .info ul {
    margin-bottom: 0;
  }

  .lead {
    margin-bottom: 0.4em;
    font-weight: 600;
  }

  :global(.room-photo) {
    aspect-ratio: 4 / 3;
  }

  .room {
    margin-top: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .room-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.4rem;
  }

  .room h3 {
    flex: 1 1 14rem;
    margin: 0;
    font-size: 1.15rem;
  }

  .room > p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--red-dark);
    white-space: nowrap;
  }

  .price .cur {
    font-size: 0.6em;
    letter-spacing: 0.06em;
  }

  .price .per {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 400;
    text-align: right;
    color: var(--ink-soft);
  }

  .cta {
    text-align: center;
    text-align: center;
  }
</style>
