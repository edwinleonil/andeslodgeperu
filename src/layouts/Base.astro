---
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { img } from '../data/images';
import { phones, site } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page name; omit on the home page */
  title?: string;
  description?: string;
  /** Image name used when the page is shared on social media */
  shareImage?: string;
  noindex?: boolean;
}

const { title, description = site.description, shareImage = 'yanama-valley-panorama', noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Guesthouse in Yanama, Ancash`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: img(shareImage).src, width: 1200, format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
const icon = await getImage({ src: img('logo').src, width: 96, height: 96, fit: 'cover', format: 'png' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  image: shareUrl.href,
  email: site.email,
  telephone: `+${phones[0].number}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  checkinTime: '15:00',
  checkoutTime: '12:00',
  sameAs: [site.tripadvisor],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={icon.src} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 30;
    padding: 0.6rem 1rem;
    background: var(--white);
  }

  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>
