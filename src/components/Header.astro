---
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { nav, site } from '../data/site';

const logo = img('logo');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <Image src={logo.src} alt="" width={48} height={54} loading="eager" />
      <span>{site.name}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.getElementById('site-nav');
    if (!toggle || !nav) return;
    const setOpen = (open) => {
      nav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 0.6rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand img {
    width: 48px;
    height: auto;
    border-radius: 6px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-right: -9px; /* keeps the icon on the page margin */
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.4rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--red-dark);
    border-bottom-color: var(--red);
  }

  @media (max-width: 819px) {
    /* Keep logo, name and menu button on one line down to 320px wide */
    .bar {
      gap: 0 0.5rem;
    }

    .brand {
      flex: 1 1 0;
      min-width: 0;
      gap: 0.6rem;
      font-size: clamp(0.85rem, 4.2vw, 1.15rem);
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .brand img {
      width: 40px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    nav {
      display: none;
      flex-basis: 100%;
    }

    nav.open {
      display: block;
    }

    ul {
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.5rem;
    }

    nav a {
      padding: 0.8rem 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--line);
    }

    nav li:last-child a {
      border-bottom-color: transparent;
    }
  }
</style>
