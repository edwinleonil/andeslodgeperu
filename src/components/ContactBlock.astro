---
import { phones, site, whatsappLink } from '../data/site';
---

<div class="contact">
  <p>The best way to arrange a reservation is through WhatsApp, using the following numbers:</p>

  <ul class="numbers">
    {
      phones.map((p) => (
        <li>
          <a href={whatsappLink(p.number)} rel="noopener">
            <svg class="wa" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.5 3.9 1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"
              ></path>
            </svg>
            <span class="country">{p.country}</span>
            <span class="number">{p.display}</span>
            <span class="langs">{p.languages}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p>
    Please include the following in the first line of your message: "{site.whatsappMessage}"
  </p>
  <p>
    <strong>Payment:</strong> we do not take online payments. All payments are made in cash on arrival at the
    lodge.
  </p>
</div>

<style>
  .contact {
    max-width: 68ch;
  }

  .numbers {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .numbers a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s var(--ease);
  }

  .numbers a > span {
    grid-column: 2;
  }

  .wa {
    grid-row: 1 / span 3;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.45rem;
    border-radius: 50%;
    background: #e8f8ee;
    color: #128c4a;
  }

  .numbers a:hover {
    border-color: var(--red);
    color: var(--ink);
  }

  @media (hover: hover) {
    .numbers a:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
  }

  .country {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .number {
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .langs {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
</style>
