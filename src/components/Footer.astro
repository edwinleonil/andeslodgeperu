---
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { nav, phones, site, whatsappLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <a class="brand" href="/">
        <Image src={img('logo').src} alt="" width={44} height={50} />
        <span class="name">{site.name}</span>
      </a>
      <p class="tag">Family-run guesthouse in Yanama, next to the Huascaran National Park.</p>
      <p>{site.address.display}</p>
      <p class="label">Reviews</p>
      <ul>
        <li><a href={site.tripadvisor} rel="noopener">Tripadvisor</a></li>
        <li><a href={site.googleReviews} rel="noopener">Google</a></li>
      </ul>
    </div>

    <div>
      <p class="label">WhatsApp</p>
      <ul>
        {
          phones.map((p) => (
            <li>
              {p.country}: <a href={whatsappLink(p.number)} rel="noopener">{p.display}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="label">Explore</p>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap legal">© {year} {site.name}</div>
</footer>

<style>
  .site-footer {
    padding-block: 3rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    background: var(--night);
    color: #d9d4cd;
    border-top: 4px solid var(--red);
    font-size: 0.95rem;
  }

  .cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }

  .brand img {
    width: 44px;
    height: auto;
    border-radius: 6px;
  }

  .tag {
    max-width: 30ch;
    color: #a39c93;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--white);
  }

  .label {
    margin-bottom: 0.4em;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a39c93;
  }

  ul {
    margin: 0 0 1em;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--white);
  }

  a:hover {
    color: #ffb3bf;
  }

  /* Phones: give each link a finger-sized tap area */
  @media (max-width: 819px) {
    li a,
    p > a {
      display: inline-block;
      padding-block: 0.75rem;
    }

    ul {
      margin-bottom: 0;
    }
  }

  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #3a3632;
    font-size: 0.85rem;
    color: #a39c93;
  }
</style>
